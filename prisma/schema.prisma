generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PostModule {
  HOUSING
  JOBS
  MARKETPLACE
  TRIPS
  COMMUNITY
}

enum PostStatus {
  ACTIVE
  CLOSED
  DELETED
}

enum TripStatus {
  OPEN
  FULL
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  countryOrigin String?
  cityNz        String?
  avatarUrl     String?
  bio           String?
  oficio              String?
  descripcionServicio String?
  contactoDirectorio  String?
  instagram           String?
  tiktok              String?
  facebook            String?
  lastSeenAt         DateTime?
  emailVerified      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  posts                    Post[]
  tripsCreated             Trip[]
  tripBookings             TripBooking[]
  sentMessages             Message[]      @relation("SentMessages")
  receivedMessages         Message[]      @relation("ReceivedMessages")
  reports                  Report[]
  refreshTokens            RefreshToken[]
  likes                    PostLike[]
  comments                 Comment[]
  pushTokens               UserPushToken[]
  passwordResetTokens      PasswordResetToken[]
  savedPosts               SavedPost[]
  emailVerificationTokens  EmailVerificationToken[]

  @@map("users")
}

model Post {
  id          String     @id @default(cuid())
  userId      String
  module      PostModule
  title       String
  description String
  city        String
  price       Float?
  currency    String?    @default("NZD")
  images      String[]
  status      PostStatus @default(ACTIVE)
  contactInfo String?
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  reports  Report[]
  likes    PostLike[]
  comments Comment[]
  saves    SavedPost[]

  @@index([module, city, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([userId])
  @@map("posts")
}

model Trip {
  id             String     @id @default(cuid())
  userId         String
  origin         String
  destination    String
  departureDate  DateTime
  seatsTotal     Int
  seatsAvailable Int
  costPerPerson  Float?
  currency       String?    @default("NZD")
  notes          String?
  status         TripStatus @default(OPEN)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings TripBooking[]

  @@index([origin, destination, departureDate])
  @@map("trips")
}

model TripBooking {
  id        String        @id @default(cuid())
  tripId    String
  userId    String
  seats     Int           @default(1)
  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@map("trip_bookings")
}

model Message {
  id         String    @id @default(cuid())
  senderId   String
  receiverId String
  postId     String?
  content    String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  sender   User  @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User  @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  post     Post? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([senderId, receiverId])
  @@index([receiverId, readAt])
  @@map("messages")
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  postId     String
  reason     String
  details    String?
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, reporterId])
  @@map("reports")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model UserPushToken {
  id             String    @id @default(cuid())
  userId         String
  token          String    @unique
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastNotifiedAt])
  @@map("user_push_tokens")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("comments")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model SavedPost {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@map("saved_posts")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}
